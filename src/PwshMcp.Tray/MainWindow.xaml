<Window x:Class="PwshMcp.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:PwshMcp.Tray"
        Title="{x:Static t:Copy.Product}" Width="1000" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource {x:Static t:K.Ground}}" FontFamily="{DynamicResource {x:Static t:K.UiFont}}"
        Foreground="{DynamicResource {x:Static t:K.Ink}}">
  <!--
    THESIS: admin access as a visitor badge: asked for, checked, issued with a visible window, pulled any time. Refuses the log-console-with-toggle default.
    OWN-WORLD: Windows neutrals following system theme, one indigo accent, reader-LED state colours always paired with line rules (dashed=waiting, solid=issued, struck=ended, slashed=offline). Badge silhouette = tray glyph = mark.
    STORY: notice the amber dot, read what task and which client, see the exact scope, approve through one UAC, watch the band, revoke in one step.
    0.3.0: one language at a time (header switch + tray menu), readable names lead, machine identifiers live in a collapsed Diagnostics block, commands wrap to width with PowerShell colour and copy verbatim.
  -->
  <Window.Resources>
    <!-- Command / scope / diagnostics templates live in Styles.xaml under K.*Tpl keys. -->
    <!-- Grant detail: request (pending) or access (issued / ended) -->
    <DataTemplate DataType="{x:Type t:GrantVm}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="32,28,32,28">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <t:Chip Text="{Binding StateName}" Tone="{Binding Tone}"/>
              <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Age}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource {x:Static t:K.Title}}" Text="{Binding Head}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,16,0,3" Text="{x:Static t:Copy+Detail.TaskName}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Task}}" Text="{Binding TaskName}" AutomationProperties.Name="{Binding TaskName}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Text="{x:Static t:Copy+Detail.TaskNote}"/>

            <!-- Request -->
            <StackPanel Visibility="{Binding IsPending, Converter={StaticResource {x:Static t:K.Vis}}}">
              <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,22,0,6" Text="{x:Static t:Copy+Detail.Reason}"/>
              <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Text="{Binding Reason}"/>
              <!-- Client takes the full row; times share two columns below, so narrow panes and either language keep one structure. -->
              <StackPanel Style="{StaticResource {x:Static t:K.Fact}}" Margin="0,20,0,14"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Who.Name}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Client}" ToolTip="{x:Static t:Copy+Who.SelfReported}"/></StackPanel>
              <UniformGrid Columns="2">
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Submitted}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Submitted}"/></StackPanel>
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.RequestEnds}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding RequestEnds}"/></StackPanel>
              </UniformGrid>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.ScopeTpl}}" Margin="0,-2,0,0"/>

              <!-- The badge before it is issued: what approving means. How long it lasts is chosen from the footer link beside Approve. -->
              <Border Style="{StaticResource {x:Static t:K.Issue}}" Visibility="{Binding GateBad, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource {x:Static t:K.Shield}}" Fill="{DynamicResource {x:Static t:K.Accent}}" Width="13" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static t:Copy+Inline.Head}"/>
                  </StackPanel>
                  <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Margin="0,10,0,0" FontSize="13.5" LineHeight="20" Text="{Binding Allows}"/>
                </StackPanel>
              </Border>

              <!-- Executor unavailable: same position, says why and what to do. Approve stays disabled; nothing falls back to a Windows prompt. -->
              <Border Style="{StaticResource {x:Static t:K.Blocked}}" Visibility="{Binding GateBad, Converter={StaticResource {x:Static t:K.Vis}}}">
                <StackPanel>
                  <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static t:Copy+Gate.Head}"/>
                  <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Margin="0,8,0,0" FontSize="13.5" LineHeight="20" Text="{Binding GateBody}"/>
                  <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static t:Copy+Gate.NoPrompt}"/>
                  <WrapPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource {x:Static t:K.Secondary}}" Margin="0,0,12,0" Command="{Binding Recheck}" Content="{x:Static t:Copy+Gate.Recheck}"/>
                    <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0" VerticalAlignment="Center" Text="{Binding GateAt}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Text="{Binding WaitingHead}"/>
              <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{x:Static t:Copy+Detail.NoWaiting}"
                         Visibility="{Binding Waiting.Count, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}"/>
              <ItemsControl ItemsSource="{Binding Waiting}" ItemTemplate="{StaticResource {x:Static t:K.CmdTpl}}" Focusable="False"/>
            </StackPanel>

            <!-- Access -->
            <StackPanel Visibility="{Binding IsPending, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}">
              <Border Margin="0,20,0,0" Padding="22,18" CornerRadius="12" Background="{DynamicResource {x:Static t:K.Raised}}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left">
                      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Requested}"/>
                      <TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Requested}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" HorizontalAlignment="Right" Text="{x:Static t:Copy+Detail.Ends}"/>
                      <TextBlock Style="{StaticResource {x:Static t:K.Value}}" HorizontalAlignment="Right" TextAlignment="Right" Text="{Binding Ends}"/>
                    </StackPanel>
                  </Grid>
                  <t:Band Margin="0,14,0,12" Start="{Binding Start}" End="{Binding End}" Now="{Binding Now}"
                          Fill="{DynamicResource {x:Static t:K.Green}}" Track="{DynamicResource {x:Static t:K.Line}}" Tick="{DynamicResource {x:Static t:K.Ink}}"/>
                  <Grid Visibility="{Binding IsActive, Converter={StaticResource {x:Static t:K.Vis}}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="10" Height="10" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                      <Ellipse Fill="{DynamicResource {x:Static t:K.Green}}" Visibility="{Binding WorkerOn, Converter={StaticResource {x:Static t:K.Vis}}}"/>
                      <Ellipse Stroke="{DynamicResource {x:Static t:K.Amber}}" StrokeThickness="1.5" StrokeDashArray="2 1.5" Visibility="{Binding WorkerOn, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Style="{StaticResource {x:Static t:K.Value}}" FontSize="13" Text="{Binding Worker}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Text="{x:Static t:Copy+Detail.Reason}"/>
              <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Text="{Binding Reason}"/>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.ScopeTpl}}"/>
            </StackPanel>

            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.DiagTpl}}"/>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Padding="32,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <!-- Before an outcome exists, a pending request echoes its chosen lifetime beside Approve; clicking it opens the lifetime popup above it. -->
            <Button Style="{StaticResource {x:Static t:K.Quiet}}" Margin="-10,0,16,0" HorizontalAlignment="Left" Click="OnPicked" IsEnabled="{Binding CanPick}"
                    AutomationProperties.AutomationId="{x:Static t:Names.LifeBtn}" AutomationProperties.Name="{Binding Picked}" AutomationProperties.HelpText="{x:Static t:Copy+Inline.Change}"
                    ToolTip="{x:Static t:Copy+Inline.Change}" Visibility="{Binding ShowPick, Converter={StaticResource {x:Static t:K.Vis}}}">
              <DockPanel>
                <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" StrokeThickness="1.5" Width="9" Height="5" Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                  <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
                </Path>
                <TextBlock FontWeight="Normal" TextWrapping="Wrap" Text="{Binding Picked}"/>
              </DockPanel>
            </Button>
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Text="{Binding Footer}" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding ShowPick, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding NoticeBad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Red}}"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- Actions keep one row; on a narrow pane the notice wraps instead of the buttons. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource {x:Static t:K.Secondary}}" Margin="10,0,0,0" Command="{Binding Restart}" IsEnabled="{Binding CanApprove}">
                <Button.Visibility>
                  <MultiBinding Converter="{x:Static t:All.Vis}"><Binding Path="IsActive"/><Binding Path="WorkerOn" Converter="{x:Static t:All.Not}"/></MultiBinding>
                </Button.Visibility>
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter Content="{Binding Sending}" ContentTemplate="{StaticResource {x:Static t:K.BusyTpl}}" Margin="0,0,8,0"/>
                  <AccessText Text="{Binding RestartText}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource {x:Static t:K.Danger}}" Margin="10,0,0,0" Command="{Binding Revoke.Click}" Tag="{Binding Revoke.Tag}"
                      Visibility="{Binding IsActive, Converter={StaticResource {x:Static t:K.Vis}}}" Content="{Binding Revoke.Text}"/>
              <Button Style="{StaticResource {x:Static t:K.Danger}}" Margin="10,0,0,0" Command="{Binding Deny.Click}" Tag="{Binding Deny.Tag}"
                      Visibility="{Binding IsPending, Converter={StaticResource {x:Static t:K.Vis}}}" Content="{Binding Deny.Text}"/>
              <Button Style="{StaticResource {x:Static t:K.Primary}}" Margin="10,0,0,0" Command="{Binding Approve}" IsEnabled="{Binding CanApprove}"
                      Visibility="{Binding IsPending, Converter={StaticResource {x:Static t:K.Vis}}}">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter Content="{Binding Sending}" ContentTemplate="{StaticResource {x:Static t:K.BusyTpl}}" Margin="0,0,8,0"/>
                  <AccessText Text="{Binding ApproveText}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- Task detail -->
    <DataTemplate DataType="{x:Type t:JobVm}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel Margin="32,28,32,28">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <t:Chip Text="{Binding StateName}" Tone="{Binding Tone}"/>
              <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Submitted}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource {x:Static t:K.Title}}" Text="{Binding Head}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,16,0,3" Text="{x:Static t:Copy+Detail.Description}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Desc}}" DataContext="{Binding Cmd}" Text="{Binding Desc, Mode=OneWay}" AutomationProperties.Name="{Binding Desc, Mode=OneWay}"/>
            <!-- Task name takes the full row; client and privilege share two columns below, the same structure in either language. -->
            <StackPanel Style="{StaticResource {x:Static t:K.Fact}}" Margin="0,20,0,14">
                <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.TaskName}"/>
                <TextBlock Text="{Binding TaskName}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Value}}">
                      <Style.Triggers><DataTrigger Binding="{Binding HasTask}" Value="False"><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <UniformGrid Columns="2">
              <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Who.Name}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Client}" ToolTip="{x:Static t:Copy+Who.SelfReported}"/></StackPanel>
              <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Privilege}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Privilege}"/></StackPanel>
            </UniformGrid>
            <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,8,0,10" Text="{x:Static t:Copy+Detail.Code}"/>
            <ContentPresenter Margin="0,0,0,16" Content="{Binding Cmd}" ContentTemplate="{StaticResource {x:Static t:K.CodeTpl}}"/>

            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource {x:Static t:K.Vis}}}">
              <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,10,0,10" Text="{x:Static t:Copy+Detail.Result}"/>
              <UniformGrid Columns="2">
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.ExitCode}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding ExitCode}"/></StackPanel>
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Identity}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Identity}"/></StackPanel>
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Engine}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Engine}"/></StackPanel>
                <StackPanel Style="{StaticResource {x:Static t:K.Fact}}"><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Text="{x:Static t:Copy+Detail.Environment}"/><TextBlock Style="{StaticResource {x:Static t:K.Value}}" Text="{Binding Environment}"/></StackPanel>
              </UniformGrid>
            </StackPanel>

            <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,10,0,6" Text="{x:Static t:Copy+Detail.Output}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource {x:Static t:K.Body}}" FontSize="13" Foreground="{DynamicResource {x:Static t:K.Muted}}" VerticalAlignment="Center" Text="{Binding OutputHint}"/>
              <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource {x:Static t:K.Quiet}}" Command="{Binding Toggle}"
                      Visibility="{Binding HasResult, Converter={StaticResource {x:Static t:K.Vis}}}" Content="{Binding ToggleText}"/>
            </Grid>
            <TextBox Style="{StaticResource {x:Static t:K.CodeBox}}" Margin="0,10,0,0" MaxHeight="320" Text="{Binding Output, Mode=OneWay}"
                     Visibility="{Binding Shown, Converter={StaticResource {x:Static t:K.Vis}}}" AutomationProperties.Name="{x:Static t:Copy+Detail.Output}"/>
            <StackPanel Visibility="{Binding Errors, Converter={StaticResource {x:Static t:K.Vis}}}">
              <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,14,0,4" Foreground="{DynamicResource {x:Static t:K.Red}}" Text="{x:Static t:Copy+Detail.ErrorStream}"/>
              <TextBox Style="{StaticResource {x:Static t:K.CodeBox}}" Text="{Binding Errors, Mode=OneWay}" AutomationProperties.Name="{x:Static t:Copy+Detail.ErrorStream}"/>
            </StackPanel>

            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.DiagTpl}}"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Padding="32,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding NoticeBad}" Value="True"><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Red}}"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Grid.Column="1" Style="{StaticResource {x:Static t:K.Danger}}" Command="{Binding Cancel.Click}" Tag="{Binding Cancel.Tag}"
                    Visibility="{Binding CanCancel, Converter={StaticResource {x:Static t:K.Vis}}}" Content="{Binding Cancel.Text}"/>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- Header strip: identity · connection (shrinks first) · notice · language · revoke all -->
    <Border Background="{DynamicResource {x:Static t:K.Panel}}" BorderBrush="{DynamicResource {x:Static t:K.Line}}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="{StaticResource {x:Static t:K.Mark}}" Fill="{DynamicResource {x:Static t:K.Accent}}" Width="22" Height="22" Stretch="Uniform"/>
          <TextBlock Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static t:Copy.Product}"/>
          <TextBlock Margin="8,1,22,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{x:Static t:Copy.Version}"
                     Typography.NumeralAlignment="Tabular"/>
        </StackPanel>
        <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True" Margin="0,0,16,0">
          <t:Chip DockPanel.Dock="Left" Text="{Binding ConnTitle}" Tone="{Binding ConnTone}"/>
          <t:Chip DockPanel.Dock="Left" Margin="8,0,0,0" Text="{Binding GateTitle}" Tone="{Binding GateTone}" ToolTip="{Binding GateTip}"/>
          <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding Stale}"/>
          <TextBlock Margin="12,0,0,0" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static t:K.Muted}}"
                     Text="{Binding ConnDetail}" ToolTip="{Binding ConnDetail}"/>
        </DockPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock MaxWidth="240" Margin="0,0,12,0" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static t:K.Red}}" Text="{Binding Notice}"/>
          <Button Style="{StaticResource {x:Static t:K.Secondary}}" Margin="0,0,10,0" Command="{Binding Retry}" Content="{x:Static t:Copy+Conn.Retry}"
                  Visibility="{Binding Online, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}"/>
          <Border Background="{DynamicResource {x:Static t:K.Raised}}" CornerRadius="8" Padding="2" Margin="0,0,10,0" ToolTip="{x:Static t:Copy+Lang.Hint}"
                  AutomationProperties.Name="{x:Static t:Copy+Lang.Label}" AutomationProperties.HelpText="{x:Static t:Copy+Lang.Hint}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource {x:Static t:K.Lang}}" GroupName="lang" IsChecked="{Binding IsZh}" Content="{x:Static t:Copy+Lang.Zh}" Language="zh-CN"/>
              <RadioButton Style="{StaticResource {x:Static t:K.Lang}}" GroupName="lang" IsChecked="{Binding IsEn}" Content="{x:Static t:Copy+Lang.En}" Language="en-US"/>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource {x:Static t:K.Danger}}" Command="{Binding RevokeAll.Click}" Tag="{Binding RevokeAll.Tag}" Content="{Binding RevokeAll.Text}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="400"/>
      </Grid.ColumnDefinitions>

      <!-- Left: segmented lists. Rows lead with the task or description; the readable client name follows. -->
      <DockPanel Margin="16,16,12,12">
        <Border DockPanel.Dock="Top" Background="{DynamicResource {x:Static t:K.Raised}}" CornerRadius="8" Padding="3" Margin="0,0,0,12">
          <UniformGrid Columns="3">
            <RadioButton Style="{StaticResource {x:Static t:K.Segment}}" GroupName="tabs" IsChecked="{Binding IsReq}" Content="{Binding RequestsTab}"/>
            <RadioButton Style="{StaticResource {x:Static t:K.Segment}}" GroupName="tabs" IsChecked="{Binding IsAcc}" Content="{Binding AccessTab}"/>
            <RadioButton Style="{StaticResource {x:Static t:K.Segment}}" GroupName="tabs" IsChecked="{Binding IsTask}" Content="{Binding TasksTab}"/>
          </UniformGrid>
        </Border>
        <Grid>
          <StackPanel Margin="12,28,12,0" Visibility="{Binding IsEmpty, Converter={StaticResource {x:Static t:K.Vis}}}">
            <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding EmptyHead}"/>
            <TextBlock Style="{StaticResource {x:Static t:K.Body}}" Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding EmptyBody}"/>
          </StackPanel>

          <ListBox x:Name="reqList" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelReq}" ItemContainerStyle="{StaticResource {x:Static t:K.Row}}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static t:Copy+Tabs.Requests}"
                   Visibility="{Binding IsReq, Converter={StaticResource {x:Static t:K.Vis}}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid AutomationProperties.Name="{Binding Spoken}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left" Fill="{DynamicResource {x:Static t:K.Amber}}"
                           Visibility="{Binding IsNew, Converter={StaticResource {x:Static t:K.Vis}}}"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding TaskLine}" ToolTip="{Binding TaskName}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontWeight" Value="SemiBold"/>
                          <Style.Triggers><DataTrigger Binding="{Binding HasTask}" Value="False"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding Client}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" FontSize="12" Margin="10,2,0,0" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding Age}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox x:Name="accList" ItemsSource="{Binding Access}" SelectedItem="{Binding SelAcc}" ItemContainerStyle="{StaticResource {x:Static t:K.Row}}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static t:Copy+Tabs.Access}"
                   Visibility="{Binding IsAcc, Converter={StaticResource {x:Static t:K.Vis}}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel AutomationProperties.Name="{Binding Spoken}">
                  <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,8,0,10" Text="{x:Static t:Copy+Tabs.Ended}"
                             Visibility="{Binding Divider, Converter={StaticResource {x:Static t:K.Vis}}}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding TaskLine}" ToolTip="{Binding TaskName}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasTask}" Value="False"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/></DataTrigger></Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static t:K.Muted}}">
                        <Run Text="{Binding Client, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding RowSub, Mode=OneWay}"/>
                      </TextBlock>
                    </StackPanel>
                    <t:Chip Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Text="{Binding StateName}" Tone="{Binding Tone}"/>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox x:Name="taskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelTask}" ItemContainerStyle="{StaticResource {x:Static t:K.Row}}"
                   Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static t:Copy+Tabs.Tasks}"
                   VirtualizingPanel.IsVirtualizing="True" Visibility="{Binding IsTask, Converter={StaticResource {x:Static t:K.Vis}}}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid AutomationProperties.Name="{Binding Spoken}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis" Text="{Binding Line}" ToolTip="{Binding Line}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontWeight" Value="SemiBold"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDesc}" Value="False"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource {x:Static t:K.Muted}}">
                      <Run Text="{Binding Client, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Age, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                  <t:Chip Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top" Text="{Binding StateName}" Tone="{Binding Tone}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False">
        <GridSplitter.Template>
          <ControlTemplate TargetType="GridSplitter">
            <Border Background="Transparent"><Rectangle Width="1" Fill="{DynamicResource {x:Static t:K.Line}}"/></Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!-- Right: detail -->
      <Border Grid.Column="2" Background="{DynamicResource {x:Static t:K.Panel}}">
        <Grid>
          <TextBlock Margin="32" FontSize="14" Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{x:Static t:Copy+Empty.Select}" TextWrapping="Wrap"
                     Visibility="{Binding Selected, Converter={StaticResource {x:Static t:K.Vis}}, ConverterParameter=not}"/>
          <ContentControl x:Name="detail" Content="{Binding Selected}" Focusable="False" IsTabStop="False">
            <ContentControl.RenderTransform><TranslateTransform x:Name="rise"/></ContentControl.RenderTransform>
          </ContentControl>
        </Grid>
      </Border>
    </Grid>

    <!-- Lifetime popup: one per window, anchored above the footer link, bound to exactly one pending request while open (MainWindow.xaml.cs). -->
    <Popup x:Name="life" StaysOpen="False" Placement="Top" AllowsTransparency="True" HorizontalOffset="-10" VerticalOffset="6" Focusable="False" Closed="OnLifeClosed">
      <Border x:Name="lifeCard" Style="{StaticResource {x:Static t:K.Pop}}" PreviewKeyDown="OnLifeKey"
              TextElement.FontFamily="{DynamicResource {x:Static t:K.UiFont}}" TextElement.Foreground="{DynamicResource {x:Static t:K.Ink}}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" AutomationProperties.Name="{x:Static t:Copy+Inline.Lasts}">
        <StackPanel>
          <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="12,0,12,6" FontWeight="SemiBold" Text="{x:Static t:Copy+Inline.Lasts}"/>
          <StackPanel KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
            <RadioButton Style="{StaticResource {x:Static t:K.Pick}}" Tag="{x:Static t:Life.SignOut}" IsChecked="{Binding IsSignOut, Mode=OneWay}" Click="OnLife"
                         AutomationProperties.Name="{Binding Source={x:Static t:Copy+Inline.SignOut}, Converter={x:Static t:All.Plain}}" AutomationProperties.HelpText="{Binding SignOutEnd}">
              <StackPanel><AccessText Text="{x:Static t:Copy+Inline.SignOut}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,0" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding SignOutEnd}"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource {x:Static t:K.Pick}}" Tag="{x:Static t:Life.OneHour}" IsChecked="{Binding IsHour, Mode=OneWay}" Click="OnLife"
                         AutomationProperties.Name="{Binding Source={x:Static t:Copy+Inline.OneHour}, Converter={x:Static t:All.Plain}}" AutomationProperties.HelpText="{Binding HourEnd}">
              <StackPanel><AccessText Text="{x:Static t:Copy+Inline.OneHour}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,0" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding HourEnd}" Typography.NumeralAlignment="Tabular"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource {x:Static t:K.Pick}}" Tag="{x:Static t:Life.FourHours}" IsChecked="{Binding IsFour, Mode=OneWay}" Click="OnLife"
                         AutomationProperties.Name="{Binding Source={x:Static t:Copy+Inline.FourHours}, Converter={x:Static t:All.Plain}}" AutomationProperties.HelpText="{Binding FourEnd}">
              <StackPanel><AccessText Text="{x:Static t:Copy+Inline.FourHours}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,0" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding FourEnd}" Typography.NumeralAlignment="Tabular"/></StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource {x:Static t:K.Pick}}" Tag="{x:Static t:Life.Today}" IsChecked="{Binding IsToday, Mode=OneWay}" Click="OnLife"
                         AutomationProperties.Name="{Binding Source={x:Static t:Copy+Inline.Today}, Converter={x:Static t:All.Plain}}" AutomationProperties.HelpText="{Binding TodayEnd}">
              <StackPanel><AccessText Text="{x:Static t:Copy+Inline.Today}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,0" FontWeight="Normal" TextWrapping="Wrap" Text="{Binding TodayEnd}" Typography.NumeralAlignment="Tabular"/></StackPanel>
            </RadioButton>
          </StackPanel>
          <Rectangle Height="1" Margin="12,8,12,0" Fill="{DynamicResource {x:Static t:K.Line}}"/>
          <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="12,8,12,4" TextWrapping="Wrap" Text="{Binding Applies}"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>

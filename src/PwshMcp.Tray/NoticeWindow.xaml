<Window x:Class="PwshMcp.Tray.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:PwshMcp.Tray"
        Title="{x:Static t:Copy+Notify.Title}" Width="480" Height="680" MinWidth="360" MinHeight="320"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="CanResize"
        Background="{DynamicResource {x:Static t:K.Panel}}" Foreground="{DynamicResource {x:Static t:K.Ink}}"
        FontFamily="{DynamicResource {x:Static t:K.UiFont}}" UseLayoutRounding="True">
  <Grid Margin="20,18,20,12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Style="{StaticResource {x:Static t:K.Scroll}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,12">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <t:Chip Text="{Binding StateName}" Tone="{Binding Tone}"/>
          <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Age}"/>
        </StackPanel>
        <TextBlock Text="{Binding Head}" Style="{StaticResource {x:Static t:K.Title}}" FontSize="20" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,14,0,3" Text="{x:Static t:Copy+Detail.TaskName}"/>
        <TextBlock Text="{Binding TaskName}" Style="{StaticResource {x:Static t:K.Task}}" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,12,0,4" Text="{x:Static t:Copy+Detail.Reason}"/>
        <TextBlock Text="{Binding Reason}" Style="{StaticResource {x:Static t:K.Reason}}"/>
        <Border Style="{StaticResource {x:Static t:K.Scope}}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{x:Static t:Copy+Who.Scope}" Style="{StaticResource {x:Static t:K.Label}}" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static t:K.Ink}}" Margin="0,0,0,6"/>
            <TextBlock Text="{x:Static t:Copy+Notify.Scope}" Style="{StaticResource {x:Static t:K.Body}}" FontSize="12.5" LineHeight="18" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding Scope}" ItemTemplate="{StaticResource {x:Static t:K.Facts}}" Grid.IsSharedSizeScope="True" Focusable="False"/>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource {x:Static t:K.Section}}" Margin="0,18,0,8" Text="{Binding WaitingHead}" Visibility="{Binding Waiting.Count, Converter={StaticResource {x:Static t:K.Vis}}}"/>
        <ItemsControl ItemsSource="{Binding Waiting}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Desc}" Style="{StaticResource {x:Static t:K.Desc}}" Margin="0,0,0,6" AutomationProperties.Name="{Binding Desc}"/>
                <t:CodeView Code="{Binding Code}" MaxBody="100"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Padding="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="count" Style="{StaticResource {x:Static t:K.Label}}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
        <TextBlock Text="{Binding Notice}" Style="{StaticResource {x:Static t:K.Body}}" Foreground="{DynamicResource {x:Static t:K.Red}}" FontSize="12" Margin="0,0,0,6" Visibility="{Binding Notice, Converter={StaticResource {x:Static t:K.Vis}}}"/>
        <TextBlock x:Name="unavailable" Text="{x:Static t:Copy+Notify.Unavailable}" Style="{StaticResource {x:Static t:K.Label}}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
        <TextBlock Text="{x:Static t:Copy+Approve.DurationHead}" Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,6"/>
        <UniformGrid Columns="2" IsEnabled="{Binding CanPick}" Margin="0,0,0,6">
          <RadioButton Style="{StaticResource {x:Static t:K.Choice}}" FontSize="12" GroupName="{x:Static t:Names.NoticeLife}" IsChecked="{Binding IsSignOut}" Content="{x:Static t:Copy+Notify.SignOut}" Margin="0,0,3,4"/>
          <RadioButton Style="{StaticResource {x:Static t:K.Choice}}" FontSize="12" GroupName="{x:Static t:Names.NoticeLife}" IsChecked="{Binding IsHour}" Content="{x:Static t:Copy+Notify.Hour}" Margin="3,0,0,4"/>
          <RadioButton Style="{StaticResource {x:Static t:K.Choice}}" FontSize="12" GroupName="{x:Static t:Names.NoticeLife}" IsChecked="{Binding IsFour}" Content="{x:Static t:Copy+Notify.Four}" Margin="0,0,3,4"/>
          <RadioButton Style="{StaticResource {x:Static t:K.Choice}}" FontSize="12" GroupName="{x:Static t:Names.NoticeLife}" IsChecked="{Binding IsToday}" Content="{x:Static t:Copy+Notify.Today}" Margin="3,0,0,4"/>
        </UniformGrid>
        <UniformGrid Columns="3">
          <Button Style="{StaticResource {x:Static t:K.Secondary}}" Padding="8,0" Content="{x:Static t:Copy+Notify.Later}" Click="OnLater" Margin="0,0,6,0"/>
          <Button Style="{StaticResource {x:Static t:K.Secondary}}" Padding="8,0" Content="{x:Static t:Copy+Notify.Details}" Click="OnDetails" Margin="0,0,6,0"/>
          <Button Style="{StaticResource {x:Static t:K.Primary}}" Padding="8,0" IsEnabled="{Binding CanApprove}" Click="OnApprove">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter Content="{Binding Sending}" ContentTemplate="{StaticResource {x:Static t:K.BusyTpl}}" Margin="0,0,6,0"/>
              <AccessText Text="{Binding ApproveText}"/>
            </StackPanel>
          </Button>
        </UniformGrid>
        <Button Style="{StaticResource {x:Static t:K.Quiet}}" HorizontalAlignment="Center" Content="{x:Static t:Copy+Notify.Enable}" Click="OnMute" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

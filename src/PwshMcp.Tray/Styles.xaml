<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:PwshMcp.Tray">

  <t:Vis x:Key="{x:Static t:K.Vis}"/>
  <!-- UAC shield silhouette and the badge mark (same geometry as the tray glyph, 16-unit box, slot punched). -->
  <Geometry x:Key="{x:Static t:K.Shield}">M8,0.8 L14.2,3.2 L14.2,7.8 C14.2,11.4 11.6,14.2 8,15.4 C4.4,14.2 1.8,11.4 1.8,7.8 L1.8,3.2 Z</Geometry>
  <Geometry x:Key="{x:Static t:K.Mark}">F0 M5.7,1.5 L10.3,1.5 A2.2,2.2 0 0 1 12.5,3.7 L12.5,12.3 A2.2,2.2 0 0 1 10.3,14.5 L5.7,14.5 A2.2,2.2 0 0 1 3.5,12.3 L3.5,3.7 A2.2,2.2 0 0 1 5.7,1.5 Z M6.75,3.7 L9.25,3.7 A0.75,0.75 0 0 1 9.25,5.2 L6.75,5.2 A0.75,0.75 0 0 1 6.75,3.7 Z</Geometry>

  <Style x:Key="pm.focusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource {x:Static t:K.Focus}}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons: one shape, four intents. -->
  <Style x:Key="{x:Static t:K.Secondary}" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Raised}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Line}}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static t:All.Plain}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="veil" CornerRadius="6" Background="Transparent"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="veil" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="veil" Property="Background" Value="{DynamicResource {x:Static t:K.Press}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static t:K.Primary}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.AccentInk}}"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
  </Style>
  <Style x:Key="{x:Static t:K.Danger}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Red}}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static t:Names.Armed}">
        <Setter Property="Background" Value="{DynamicResource {x:Static t:K.RedSoft}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Red}}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Quiet}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>

  <!-- Segmented tabs -->
  <Style x:Key="{x:Static t:K.Segment}" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="6" Padding="10,6" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Panel}}"/>
              <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="bg" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Language switch: same segmented shape as the tabs, compact, each language named in itself. -->
  <Style x:Key="{x:Static t:K.Lang}" TargetType="RadioButton" BasedOn="{StaticResource {x:Static t:K.Segment}}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="58"/>
  </Style>

  <!-- Facts: label over value, wraps as a unit -->
  <Style x:Key="{x:Static t:K.Fact}" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,36,14"/>
    <Setter Property="MinWidth" Value="150"/>
  </Style>

  <!-- Identifiers: verbatim, selectable, wrap anywhere so long keys and SIDs never clip. -->
  <Style x:Key="{x:Static t:K.Ident}" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.MonoFont}}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" BorderThickness="0,0,0,1" BorderBrush="Transparent" Padding="0,1,0,2">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Focus}}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One fact row: label column shared across the list so values line up in both languages. -->
  <!-- No DataType here: with an x:Static key plus DataType, BAML registers DataTemplateKey(Fact) and the named key never exists. -->
  <DataTemplate x:Key="{x:Static t:K.Facts}">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="factLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock FontFamily="{DynamicResource {x:Static t:K.UiFont}}" FontSize="12" Foreground="{DynamicResource {x:Static t:K.Muted}}"
                 Margin="0,2,20,0" MaxWidth="190" TextWrapping="Wrap" Text="{Binding Label}"/>
      <TextBox Grid.Column="1" Style="{StaticResource {x:Static t:K.Ident}}" Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"/>
    </Grid>
  </DataTemplate>

  <!-- Permission scope: always open, never styled away. -->
  <Style x:Key="{x:Static t:K.Scope}" TargetType="Border">
    <Setter Property="Margin" Value="0,22,0,0"/>
    <Setter Property="Padding" Value="18,14,18,8"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Line}}"/>
  </Style>

  <!-- Diagnostics disclosure: quiet, collapsed by default, keyboard reachable. -->
  <Style x:Key="{x:Static t:K.Diag}" TargetType="Expander">
    <Setter Property="Margin" Value="0,26,0,0"/>
    <Setter Property="IsExpanded" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="tg" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource pm.focusVisual}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="0,4,6,4">
                    <StackPanel Orientation="Horizontal">
                      <Path x:Name="chev" Data="M0,0 L4,4 L0,8" StrokeThickness="1.5" Width="6" Height="9" Margin="1,0,9,0" VerticalAlignment="Center"
                            Stroke="{DynamicResource {x:Static t:K.Muted}}" RenderTransformOrigin="0.5,0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform><RotateTransform x:Name="turn" Angle="0"/></Path.RenderTransform>
                      </Path>
                      <TextBlock x:Name="txt" FontFamily="{DynamicResource {x:Static t:K.UiFont}}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="txt" Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="body" Margin="16,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Duration choices in the approval window -->
  <Style x:Key="{x:Static t:K.Choice}" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static t:All.Plain}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="8" Padding="12,9" BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Background="{DynamicResource {x:Static t:K.Panel}}">
            <DockPanel>
              <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{DynamicResource {x:Static t:K.Muted}}" StrokeThickness="1.5"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource {x:Static t:K.Accent}}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Raised}}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.AccentSoft}}"/>
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource {x:Static t:K.Accent}}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- List rows -->
  <Style x:Key="{x:Static t:K.Row}" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.AccentSoft}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Type -->
  <Style x:Key="{x:Static t:K.Label}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style x:Key="{x:Static t:K.Value}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style x:Key="{x:Static t:K.Body}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Value}}">
    <Setter Property="LineHeight" Value="21"/>
    <Setter Property="MaxWidth" Value="640"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <!-- Agent-supplied audit text. Old records without it read as muted fallback copy, never as real content. -->
  <Style x:Key="{x:Static t:K.Desc}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Body}}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasDesc}" Value="False">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Task}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Body}}">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasTask}" Value="False">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Title}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="{x:Static t:K.Section}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Margin" Value="0,26,0,10"/>
  </Style>

  <Style x:Key="{x:Static t:K.CodeBox}" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.MonoFont}}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="MaxHeight" Value="240"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource {x:Static t:K.Code}}" BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Padding="12,10">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Focus}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared detail templates. Own keys (never a style or brush key) and app-level, so every host resolves them. -->
  <!-- Command block: directory, wrapped highlighted code, run settings -->
  <DataTemplate x:Key="{x:Static t:K.CodeTpl}">
    <StackPanel>
      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,6" TextWrapping="Wrap">
        <Run Text="{x:Static t:Copy+Detail.Cwd}"/><Run Text="  "/><Run Text="{Binding Cwd, Mode=OneWay}" FontFamily="{DynamicResource {x:Static t:K.MonoFont}}"/>
      </TextBlock>
      <t:CodeView Code="{Binding Code, Mode=OneWay}"/>
      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="2,6,0,0" Text="{Binding Meta, Mode=OneWay}" TextWrapping="Wrap"/>
    </StackPanel>
  </DataTemplate>
  <!-- Description leads; code stays underneath as the detail -->
  <DataTemplate x:Key="{x:Static t:K.CmdTpl}">
    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource {x:Static t:K.Desc}}" Margin="0,0,0,8" Text="{Binding Desc, Mode=OneWay}" AutomationProperties.Name="{Binding Desc, Mode=OneWay}"/>
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.CodeTpl}}"/>
    </StackPanel>
  </DataTemplate>
  <!-- What the grant binds to: shown in full wherever approve or revoke is offered -->
  <DataTemplate x:Key="{x:Static t:K.ScopeTpl}">
    <Border Style="{StaticResource {x:Static t:K.Scope}}">
      <StackPanel>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static t:K.Ink}}" Text="{x:Static t:Copy+Who.Scope}"/>
        <ItemsControl ItemsSource="{Binding Scope}" ItemTemplate="{StaticResource {x:Static t:K.Facts}}" Grid.IsSharedSizeScope="True" Focusable="False"/>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,6" TextWrapping="Wrap" Text="{x:Static t:Copy+Who.ScopeNote}"/>
      </StackPanel>
    </Border>
  </DataTemplate>
  <!-- Internal identifiers: collapsed, verbatim, selectable -->
  <DataTemplate x:Key="{x:Static t:K.DiagTpl}">
    <Expander Style="{StaticResource {x:Static t:K.Diag}}" Header="{x:Static t:Copy+Diag.Head}">
      <StackPanel>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{x:Static t:Copy+Diag.Note}"/>
        <ItemsControl ItemsSource="{Binding Diag}" ItemTemplate="{StaticResource {x:Static t:K.Facts}}" Grid.IsSharedSizeScope="True" Focusable="False"/>
      </StackPanel>
    </Expander>
  </DataTemplate>
</ResourceDictionary>

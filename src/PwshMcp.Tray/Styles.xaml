<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:PwshMcp.Tray">

  <t:Vis x:Key="{x:Static t:K.Vis}"/>
  <!-- UAC shield silhouette and the badge mark (same geometry as the tray glyph, 16-unit box, slot punched). -->
  <Geometry x:Key="{x:Static t:K.Shield}">M8,0.8 L14.2,3.2 L14.2,7.8 C14.2,11.4 11.6,14.2 8,15.4 C4.4,14.2 1.8,11.4 1.8,7.8 L1.8,3.2 Z</Geometry>
  <Geometry x:Key="{x:Static t:K.Mark}">F0 M5.7,1.5 L10.3,1.5 A2.2,2.2 0 0 1 12.5,3.7 L12.5,12.3 A2.2,2.2 0 0 1 10.3,14.5 L5.7,14.5 A2.2,2.2 0 0 1 3.5,12.3 L3.5,3.7 A2.2,2.2 0 0 1 5.7,1.5 Z M6.75,3.7 L9.25,3.7 A0.75,0.75 0 0 1 9.25,5.2 L6.75,5.2 A0.75,0.75 0 0 1 6.75,3.7 Z</Geometry>

  <Style x:Key="pm.focusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2" Stroke="{DynamicResource {x:Static t:K.Focus}}" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons: one shape, four intents. -->
  <Style x:Key="{x:Static t:K.Secondary}" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Raised}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Line}}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static t:All.Plain}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
            <Border x:Name="veil" CornerRadius="6" Background="Transparent"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="veil" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="veil" Property="Background" Value="{DynamicResource {x:Static t:K.Press}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static t:K.Primary}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.AccentInk}}"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
  </Style>
  <Style x:Key="{x:Static t:K.Danger}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Red}}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static t:Names.Armed}">
        <Setter Property="Background" Value="{DynamicResource {x:Static t:K.RedSoft}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Red}}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Quiet}" TargetType="Button" BasedOn="{StaticResource {x:Static t:K.Secondary}}">
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>

  <!-- Segmented tabs -->
  <Style x:Key="{x:Static t:K.Segment}" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="6" Padding="10,6" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Panel}}"/>
              <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="bg" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.14"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Language switch: same segmented shape as the tabs, compact, each language named in itself. -->
  <Style x:Key="{x:Static t:K.Lang}" TargetType="RadioButton" BasedOn="{StaticResource {x:Static t:K.Segment}}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinWidth" Value="58"/>
  </Style>

  <!-- Facts: label over value in a fixed UniformGrid column; text wraps inside it, so columns and order never depend on font width -->
  <Style x:Key="{x:Static t:K.Fact}" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,24,14"/>
  </Style>

  <!-- Identifiers: verbatim, selectable, wrap anywhere so long keys and SIDs never clip. -->
  <Style x:Key="{x:Static t:K.Ident}" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.MonoFont}}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" BorderThickness="0,0,0,1" BorderBrush="Transparent" Padding="0,1,0,2">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Focus}}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One fact row: label column shared across the list so values line up in both languages. -->
  <!-- No DataType here: with an x:Static key plus DataType, BAML registers DataTemplateKey(Fact) and the named key never exists. -->
  <DataTemplate x:Key="{x:Static t:K.Facts}">
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="factLabel"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock FontFamily="{DynamicResource {x:Static t:K.UiFont}}" FontSize="12" Foreground="{DynamicResource {x:Static t:K.Muted}}"
                 Margin="0,2,20,0" MaxWidth="190" TextWrapping="Wrap" Text="{Binding Label}"/>
      <TextBox Grid.Column="1" Style="{StaticResource {x:Static t:K.Ident}}" Text="{Binding Value, Mode=OneWay}" AutomationProperties.Name="{Binding Label}"/>
    </Grid>
  </DataTemplate>

  <!-- Permission scope: always open, never styled away. -->
  <Style x:Key="{x:Static t:K.Scope}" TargetType="Border">
    <Setter Property="Margin" Value="0,22,0,0"/>
    <Setter Property="Padding" Value="18,14,18,8"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Line}}"/>
  </Style>

  <!-- Diagnostics disclosure: quiet, collapsed by default, keyboard reachable. -->
  <Style x:Key="{x:Static t:K.Diag}" TargetType="Expander">
    <Setter Property="Margin" Value="0,26,0,0"/>
    <Setter Property="IsExpanded" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="tg" HorizontalAlignment="Left" Cursor="Hand" FocusVisualStyle="{StaticResource pm.focusVisual}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Content="{TemplateBinding Header}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" Padding="0,4,6,4">
                    <StackPanel Orientation="Horizontal">
                      <Path x:Name="chev" Data="M0,0 L4,4 L0,8" StrokeThickness="1.5" Width="6" Height="9" Margin="1,0,9,0" VerticalAlignment="Center"
                            Stroke="{DynamicResource {x:Static t:K.Muted}}" RenderTransformOrigin="0.5,0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.RenderTransform><RotateTransform x:Name="turn" Angle="0"/></Path.RenderTransform>
                      </Path>
                      <TextBlock x:Name="txt" FontFamily="{DynamicResource {x:Static t:K.UiFont}}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                 Foreground="{DynamicResource {x:Static t:K.Muted}}" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="txt" Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="body" Margin="16,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="body" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Duration choices in the approval window -->
  <Style x:Key="{x:Static t:K.Choice}" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static t:All.Plain}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="8" Padding="12,9" BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Background="{DynamicResource {x:Static t:K.Panel}}">
            <DockPanel>
              <Grid Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{DynamicResource {x:Static t:K.Muted}}" StrokeThickness="1.5"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource {x:Static t:K.Accent}}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Raised}}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.AccentSoft}}"/>
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource {x:Static t:K.Accent}}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lifetime popup row: radio ring, choice on the first line, the deadline it means on the second. Content is a two-line StackPanel. -->
  <Style x:Key="{x:Static t:K.Pick}" TargetType="RadioButton" BasedOn="{StaticResource {x:Static t:K.Choice}}">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="GroupName" Value="pm.life"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bg" CornerRadius="7" Padding="12,8,14,8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
            <DockPanel>
              <Grid Width="14" Height="14" Margin="0,3,11,0" VerticalAlignment="Top">
                <Ellipse x:Name="ring" Stroke="{DynamicResource {x:Static t:K.Muted}}" StrokeThickness="1.5"/>
                <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource {x:Static t:K.Accent}}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.AccentSoft}}"/>
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource {x:Static t:K.Accent}}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <!-- Keyboard focus draws on the row itself so the ring stays legible inside the popup's tight padding. -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Focus}}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Lifetime popup surface: the panel colour lifted off the footer by a soft shadow; the outer margin is room for that shadow. -->
  <Style x:Key="{x:Static t:K.Pop}" TargetType="Border">
    <Setter Property="Margin" Value="10"/>
    <Setter Property="Width" Value="336"/>
    <Setter Property="Padding" Value="6,10,6,6"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Line}}"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Panel}}"/>
    <Setter Property="Effect">
      <Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.32"/></Setter.Value>
    </Setter>
  </Style>

  <!-- Approval card: the same raised card an issued grant uses, so approving visibly turns this card into that one. -->
  <Style x:Key="{x:Static t:K.Issue}" TargetType="Border">
    <Setter Property="Margin" Value="0,18,0,0"/>
    <Setter Property="Padding" Value="20,18,14,16"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.Raised}}"/>
  </Style>
  <!-- Executor unavailable: same slot and shape, amber wash = waiting on something outside the tray. -->
  <Style x:Key="{x:Static t:K.Blocked}" TargetType="Border">
    <Setter Property="Margin" Value="0,18,0,0"/>
    <Setter Property="Padding" Value="20,18,20,16"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource {x:Static t:K.AmberSoft}}"/>
  </Style>

  <!-- Button glyph: shield at rest, a turning arc while the exchange is in flight. Content is the Sending flag. -->
  <DataTemplate x:Key="{x:Static t:K.BusyTpl}">
    <Grid Width="14" Height="14">
      <Path x:Name="shield" Data="{StaticResource {x:Static t:K.Shield}}" Width="13" Height="14" Stretch="Uniform"
            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Path x:Name="arc" Data="M7,1.5 A5.5,5.5 0 1 1 1.5,7" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform><RotateTransform x:Name="spin"/></Path.RenderTransform>
      </Path>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding}" Value="True">
        <Setter TargetName="shield" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="arc" Property="Visibility" Value="Visible"/>
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="turning">
            <Storyboard><DoubleAnimation Storyboard.TargetName="spin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="turning"/></DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Scrollbars: a quiet 10px gutter, no arrow buttons, the track pages. The thumb is a 4px muted pill that widens to 8px
       while the pointer is anywhere over the gutter and takes the accent while dragged; the whole gutter width is its hit target. -->
  <Style x:Key="{x:Static t:K.Page}" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="{x:Static t:K.Thumb}" TargetType="Thumb">
    <Border Background="Transparent">
      <Border x:Name="pill" CornerRadius="4" Margin="3,1" Opacity="0.42" Background="{DynamicResource {x:Static t:K.Muted}}" SnapsToDevicePixels="True"/>
    </Border>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
        <Setter TargetName="pill" Property="Margin" Value="1,3"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
        <Setter TargetName="pill" Property="Margin" Value="1"/>
        <Setter TargetName="pill" Property="Opacity" Value="0.7"/>
      </DataTrigger>
      <Trigger Property="IsDragging" Value="True">
        <Setter TargetName="pill" Property="Margin" Value="1"/>
        <Setter TargetName="pill" Property="Opacity" Value="1"/>
        <Setter TargetName="pill" Property="Background" Value="{DynamicResource {x:Static t:K.Accent}}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Cursor" Value="Arrow"/>
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource {x:Static t:K.Page}}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource {x:Static t:K.Page}}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Template="{StaticResource {x:Static t:K.Thumb}}" MinHeight="24"/></Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource {x:Static t:K.Page}}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource {x:Static t:K.Page}}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Template="{StaticResource {x:Static t:K.Thumb}}" MinWidth="24"/></Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Scroll area with a stable gutter: a bar set to Auto keeps its 10px even while hidden, so content never reflows or jumps
       when overflow begins or ends. Callers take the gutter out of their own outer margin, not out of the content.
       Tag=Names.Rules adds hairlines at the top/bottom viewport edge while more content lies beyond (inset to K.List's padding). -->
  <Style x:Key="{x:Static t:K.Scroll}" TargetType="ScrollViewer">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding CanContentScroll}"
                                    CanHorizontallyScroll="False" CanVerticallyScroll="False" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <Grid x:Name="rules" Margin="4,0" IsHitTestVisible="False" Visibility="Collapsed">
              <Rectangle Height="1" VerticalAlignment="Top" Fill="{DynamicResource {x:Static t:K.Line}}"
                         Visibility="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static t:All.Above}}"/>
              <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource {x:Static t:K.Line}}">
                <Rectangle.Visibility>
                  <MultiBinding Converter="{x:Static t:All.Below}">
                    <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}"/>
                    <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </Rectangle.Visibility>
              </Rectangle>
            </Grid>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="VerticalScrollBarVisibility" Value="Auto"/><Condition Property="ComputedVerticalScrollBarVisibility" Value="Collapsed"/></MultiTrigger.Conditions>
              <Setter TargetName="PART_VerticalScrollBar" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="HorizontalScrollBarVisibility" Value="Auto"/><Condition Property="ComputedHorizontalScrollBarVisibility" Value="Collapsed"/></MultiTrigger.Conditions>
              <Setter TargetName="PART_HorizontalScrollBar" Property="Visibility" Value="Hidden"/>
            </MultiTrigger>
            <Trigger Property="Tag" Value="{x:Static t:Names.Rules}"><Setter TargetName="rules" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sidebar list: the viewport reaches 4px left, 6px up/down and 12px right into the pane's existing margins, so the
       4,6,4,6 inner padding (room for the 3px focus ring and card corners) and the 10px gutter cost no row width:
       rows stay 310px wide, starting where the tab strip starts, whether or not the bar is showing. -->
  <Style x:Key="{x:Static t:K.List}" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Margin" Value="-4,-6,-12,-6"/>
    <Setter Property="Padding" Value="4,6,4,6"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer x:Name="sv" Style="{StaticResource {x:Static t:K.Scroll}}" Tag="{x:Static t:Names.Rules}" Background="{TemplateBinding Background}"
                        CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
            <ItemsPresenter Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </ScrollViewer>
          <ControlTemplate.Triggers>
            <!-- Same rule as the stock template: grouped lists that don't virtualize scroll by pixel. -->
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsGrouping" Value="True"/><Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False"/></MultiTrigger.Conditions>
              <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- List rows -->
  <Style x:Key="{x:Static t:K.Row}" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource pm.focusVisual}"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.Hover}}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{DynamicResource {x:Static t:K.AccentSoft}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Type -->
  <Style x:Key="{x:Static t:K.Label}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style x:Key="{x:Static t:K.Value}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style x:Key="{x:Static t:K.Body}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Value}}">
    <Setter Property="LineHeight" Value="21"/>
    <Setter Property="MaxWidth" Value="640"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <!-- Agent-supplied audit text. Old records without it read as muted fallback copy, never as real content. -->
  <Style x:Key="{x:Static t:K.Desc}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Body}}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasDesc}" Value="False">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Task}" TargetType="TextBlock" BasedOn="{StaticResource {x:Static t:K.Body}}">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding HasTask}" Value="False">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Muted}}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Static t:K.Title}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="{x:Static t:K.Section}" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.UiFont}}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="Margin" Value="0,26,0,10"/>
  </Style>

  <Style x:Key="{x:Static t:K.CodeBox}" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
    <Setter Property="FontFamily" Value="{DynamicResource {x:Static t:K.MonoFont}}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static t:K.Accent}}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource {x:Static t:K.Ink}}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="MaxHeight" Value="240"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <!-- Padding gives up 10px right and bottom to the stable gutters, so the text inset stays 12 / 10. -->
          <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource {x:Static t:K.Code}}" BorderThickness="1" BorderBrush="{DynamicResource {x:Static t:K.Line}}" Padding="12,10,2,0">
            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource {x:Static t:K.Scroll}}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource {x:Static t:K.Focus}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Shared detail templates. Own keys (never a style or brush key) and app-level, so every host resolves them. -->
  <!-- Command block: directory, wrapped highlighted code, run settings -->
  <DataTemplate x:Key="{x:Static t:K.CodeTpl}">
    <StackPanel>
      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,6" TextWrapping="Wrap">
        <Run Text="{x:Static t:Copy+Detail.Cwd}"/><Run Text="  "/><Run Text="{Binding Cwd, Mode=OneWay}" FontFamily="{DynamicResource {x:Static t:K.MonoFont}}"/>
      </TextBlock>
      <t:CodeView Code="{Binding Code, Mode=OneWay}"/>
      <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="2,6,0,0" Text="{Binding Meta, Mode=OneWay}" TextWrapping="Wrap"/>
    </StackPanel>
  </DataTemplate>
  <!-- Description leads; code stays underneath as the detail -->
  <DataTemplate x:Key="{x:Static t:K.CmdTpl}">
    <StackPanel Margin="0,0,0,18">
      <TextBlock Style="{StaticResource {x:Static t:K.Desc}}" Margin="0,0,0,8" Text="{Binding Desc, Mode=OneWay}" AutomationProperties.Name="{Binding Desc, Mode=OneWay}"/>
      <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource {x:Static t:K.CodeTpl}}"/>
    </StackPanel>
  </DataTemplate>
  <!-- What the grant binds to: shown in full wherever approve or revoke is offered -->
  <DataTemplate x:Key="{x:Static t:K.ScopeTpl}">
    <Border Style="{StaticResource {x:Static t:K.Scope}}">
      <StackPanel>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static t:K.Ink}}" Text="{x:Static t:Copy+Who.Scope}"/>
        <ItemsControl ItemsSource="{Binding Scope}" ItemTemplate="{StaticResource {x:Static t:K.Facts}}" Grid.IsSharedSizeScope="True" Focusable="False"/>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,2,0,6" TextWrapping="Wrap" Text="{x:Static t:Copy+Who.ScopeNote}"/>
      </StackPanel>
    </Border>
  </DataTemplate>
  <!-- Internal identifiers: collapsed, verbatim, selectable -->
  <DataTemplate x:Key="{x:Static t:K.DiagTpl}">
    <Expander Style="{StaticResource {x:Static t:K.Diag}}" Header="{x:Static t:Copy+Diag.Head}">
      <StackPanel>
        <TextBlock Style="{StaticResource {x:Static t:K.Label}}" Margin="0,0,0,10" TextWrapping="Wrap" Text="{x:Static t:Copy+Diag.Note}"/>
        <ItemsControl ItemsSource="{Binding Diag}" ItemTemplate="{StaticResource {x:Static t:K.Facts}}" Grid.IsSharedSizeScope="True" Focusable="False"/>
      </StackPanel>
    </Expander>
  </DataTemplate>
</ResourceDictionary>
